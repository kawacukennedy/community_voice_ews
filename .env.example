# ============================================================
# Community Voice EWS - Environment Configuration
# Copy this file to .env and fill in your values
# ============================================================

# --- Database ---
# Get this from Supabase: Project Settings > Database > Connection string
# Format: postgresql://user:password@host:port/database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/community_ews"

# --- Supabase (alternative to direct DB connection) ---
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_KEY="your-supabase-anon-key"
SUPABASE_JWT_SECRET="your-jwt-secret"

# --- App ---
SECRET_KEY="change-this-to-a-random-secret-string"
DEBUG=true
LOG_LEVEL="DEBUG"
ALLOWED_ORIGINS="http://localhost:5500,http://localhost:8000,https://your-frontend.vercel.app"

# --- SMS (pick one provider) ---

# Africa's Talking (free sandbox)
SMS_PROVIDER="africas_talking"
SMS_API_KEY="your-africas-talking-api-key"
SMS_USERNAME="sandbox"
SMS_SENDER_ID=""

# Twilio (free $15 credit)
TWILIO_ACCOUNT_SID="your-twilio-account-sid"
TWILIO_AUTH_TOKEN="your-twilio-auth-token"
TWILIO_PHONE_NUMBER="+1234567890"

# --- ICPAC (optional - data is public) ---
ICPAC_API_BASE="https://maps.icpac.net/ogc"
ICPAC_API_KEY=""
