# ============================================================
# Community Voice EWS - Environment Configuration
# Copy this file to .env and fill in your values
# ============================================================

# --- Database (SQLite by default - no setup needed) ---
DATABASE_URL="sqlite:///./ews.db"

# --- App ---
SECRET_KEY="change-this-to-a-random-secret-string"
LOG_LEVEL="INFO"
ALLOWED_ORIGINS="*"

# --- SMS (pick one provider) ---

# Africa's Talking (free sandbox)
SMS_PROVIDER="africas_talking"
SMS_API_KEY=""
SMS_USERNAME="sandbox"
SMS_SENDER_ID=""

# Twilio (free $15 credit)
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_PHONE_NUMBER=""

# --- ICPAC (optional - data is public) ---
ICPAC_API_BASE="https://maps.icpac.net/ogc"
